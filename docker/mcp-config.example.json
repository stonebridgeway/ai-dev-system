{
  "mcpServers": {
    "ai-dev": {
      "command": "/usr/local/bin/docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec,nosuid,size=512m",
        "--shm-size",
        "1g",
        "--network",
        "none",
        "--security-opt",
        "no-new-privileges:true",
        "--cap-drop",
        "ALL",
        "--mount",
        "type=volume,source=ai-dev-system-data,target=/data",
        "--mount",
        "type=bind,source=/home/YOU/.ai-dev/state,target=/ai-dev-state",
        "--env",
        "AI_DEV_STATE_ROOT=/ai-dev-state",
        "--mount",
        "type=bind,source=/home/YOU/AI-Dev-Projects,target=/home/YOU/AI-Dev-Projects",
        "ghcr.io/stonebridgeway/ai-dev-system:latest"
      ]
    }
  }
}
