**/node_modules/
# The clean seed carries Archify's pinned *runtime* dependencies so the locally
# executed diagram CLI works offline with no install step. The build-only
# `simple-icons` package (~23 MB, used by generate-brand-marks) stays excluded.
!docker/public-seed/03-skills-catalog/sources/external/archify/node_modules/
!docker/public-seed/03-skills-catalog/sources/external/archify/node_modules/**
docker/public-seed/03-skills-catalog/sources/external/archify/node_modules/simple-icons/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
search-index/*.sqlite
search-index/*.sqlite-*
search-index/*.lock
search-index/.dense-query-*.json
frontend-qa/fixtures/**/.ai-dev/frontend-qa/
frontend-qa/fixtures/**/.ai-dev/frontend-qa-baselines/
frontend-qa/artifacts/
embeddings/models/
.docker/
# `npm run dist`: the package folder and its tarball, rebuilt from the allowlist.
/dist/
docker/.env
docker/compose.local.yaml
*.log

# Skill registry / taxonomy / cards generated on demand for the bundled seed by
# `npm run skills:ensure-index` (standalone checkouts only; a full vault commits
# these under 03-skills-catalog/registries).
docker/public-seed/03-skills-catalog/registries/
docker/public-seed/03-skills-catalog/cards/
docker/public-seed/03-skills-catalog/groups/
docker/public-seed/03-skills-catalog/Skill Quality Dashboard.md
docker/public-seed/02-knowledge/Projects/
docker/public-seed/01-system/System Dashboard.md
docker/public-seed/01-system/system-dashboard.json
docker/public-seed/01-system/Knowledge Galaxy.html

# Generated live-state (machine-specific absolute paths); regenerated locally by
# `node scripts/ai-dev.mjs distribution` and the project-prep MCP tools.
runtime-distribution.json

# Running the server against this repository writes its own runtime state here:
# plans, decisions, context, the quality gate, prepared pull requests, git hooks
# and caches. None of it is tracked, and all of it carries machine-specific
# paths. Anchored to the root on purpose — an unanchored `.ai-dev/` would also
# swallow `frontend-qa/fixtures/**/.ai-dev/`, where fixture files ARE tracked,
# and quietly ignore any new one.
/.ai-dev/
/.idea/
