# No dependency install scripts. Two dependencies have one:
# - onnxruntime-node downloads the CUDA 12 provider from api.nuget.org on
#   linux/x64. The server runs on the CPU and never loads it, and the download
#   fails behind a proxy or offline, which made a plain `npm install` exit 1;
# - protobufjs prints a version-scheme warning.
# Skipping them is what `npm ci --ignore-scripts` always did. `npm run <script>`
# still runs the named script; only pre/post hooks are skipped, and this package
# has none. The package-specific key `onnxruntime-node-install=skip` works too,
# but npm 11 and 12 warn that unknown keys will stop working, then error, in a
# future major version.
ignore-scripts=true
