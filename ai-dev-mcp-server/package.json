{
  "name": "ai-dev-mcp-server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for the AI Dev System Obsidian vault and skill registry.",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node scripts/ai-dev.mjs doctor",
    "dashboard": "node scripts/ai-dev.mjs dashboard",
    "refresh": "node scripts/ai-dev.mjs refresh",
    "backup": "node scripts/ai-dev.mjs backup",
    "acceptance": "node scripts/ai-dev.mjs acceptance",
    "distribution": "node scripts/ai-dev.mjs distribution",
    "docker:seed": "node scripts/refresh-public-seed.mjs --replace",
    "docker:prepare": "node scripts/prepare-docker-context.mjs",
    "docker:audit": "node scripts/audit-docker-context.mjs",
    "docker:build": "node scripts/prepare-docker-context.mjs && docker build --tag ai-dev-system:local ../.docker/build-context",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "unix:launcher-smoke": "node scripts/unix-launcher-smoke.mjs",
    "skills:ensure-index": "node scripts/ensure-skill-index.mjs",
    "test:vault": "node scripts/ensure-skill-index.mjs && node --test",
    "packaging:check": "node scripts/validate-packaging.mjs",
    "clients:install": "node scripts/install-local-mcp-clients.mjs --apply",
    "start:legacy": "node src/mcp-stdio.mjs",
    "test": "node --test",
    "test:core": "node --test \"src/core/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/core/*.mjs --test-coverage-exclude=src/core/*.test.mjs --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=85",
    "lint": "node scripts/static-quality.mjs",
    "security": "node scripts/security-check.mjs",
    "test:legacy": "node --test src/skill-taxonomy.test.mjs src/skill-quality.test.mjs",
    "protocol:smoke": "node scripts/protocol-smoke.mjs",
    "lifecycle:smoke": "node scripts/lifecycle-smoke.mjs",
    "check": "node scripts/static-quality.mjs && node scripts/ensure-skill-index.mjs && node --test --experimental-test-coverage --test-coverage-include=src/core/*.mjs --test-coverage-exclude=src/core/*.test.mjs --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=85 && node scripts/security-check.mjs && node scripts/protocol-smoke.mjs && node scripts/lifecycle-smoke.mjs",
    "dev": "node --watch src/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  }
}
