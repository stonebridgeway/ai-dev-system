{
  "name": "ai-dev-mcp-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-dev": "bin/ai-dev.mjs"
  },
  "description": "Local MCP server for the AI Dev System Obsidian vault and skill registry.",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "start": "node src/server.mjs",
    "ai-dev": "node bin/ai-dev.mjs",
    "daemon": "node bin/ai-dev.mjs daemon run",
    "setup": "node bin/ai-dev.mjs setup",
    "demo": "node scripts/demo.mjs",
    "doctor": "node bin/ai-dev.mjs doctor",
    "dense:doctor": "node bin/ai-dev.mjs model doctor",
    "model": "node bin/ai-dev.mjs model",
    "dashboard": "node bin/ai-dev.mjs dashboard",
    "galaxy": "node bin/ai-dev.mjs galaxy",
    "refresh": "node bin/ai-dev.mjs refresh",
    "backup": "node bin/ai-dev.mjs backup",
    "acceptance": "node scripts/acceptance.mjs",
    "upgrade:test": "node scripts/upgrade-check.mjs",
    "distribution": "node bin/ai-dev.mjs distribution",
    "dist": "node scripts/build-dist.mjs",
    "dist:pack": "node scripts/build-dist.mjs --pack",
    "docker:seed": "node scripts/refresh-public-seed.mjs --replace",
    "docker:seed:verify": "node scripts/verify-public-seed.mjs",
    "docker:prepare": "node scripts/prepare-docker-context.mjs",
    "docker:audit": "node scripts/audit-docker-context.mjs",
    "docker:build": "node scripts/prepare-docker-context.mjs && docker build --tag ai-dev-system:local ../.docker/build-context",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "docker:upgrade-check": "node scripts/docker-upgrade-check.mjs",
    "unix:launcher-smoke": "node scripts/unix-launcher-smoke.mjs",
    "skills:ensure-index": "node scripts/ensure-skill-index.mjs",
    "test:vault": "node scripts/ensure-skill-index.mjs && node --import ./test/setup.mjs --test",
    "packaging:check": "node scripts/validate-packaging.mjs",
    "docs:tools": "node scripts/render-tool-reference.mjs",
    "docs:tools:check": "node scripts/render-tool-reference.mjs --check",
    "docs:links": "node scripts/doc-links.mjs",
    "clients:install": "node bin/ai-dev.mjs clients install",
    "start:legacy": "node src/mcp-stdio.mjs",
    "test": "node --import ./test/setup.mjs --test",
    "test:core": "node --import ./test/setup.mjs --test \"src/core/**/*.test.mjs\"",
    "test:coverage": "node --import ./test/setup.mjs --test --experimental-test-coverage --test-coverage-include=src/core/*.mjs --test-coverage-exclude=src/core/*.test.mjs --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=85",
    "lint": "node scripts/static-quality.mjs",
    "search:parity": "node scripts/search-parity.mjs",
    "security": "node scripts/security-check.mjs",
    "protocol:smoke": "node scripts/protocol-smoke.mjs",
    "lifecycle:smoke": "node scripts/lifecycle-smoke.mjs",
    "check": "node scripts/static-quality.mjs && node scripts/validate-packaging.mjs && node scripts/ensure-skill-index.mjs && node --import ./test/setup.mjs --test --experimental-test-coverage --test-coverage-include=src/core/*.mjs --test-coverage-exclude=src/core/*.test.mjs --test-coverage-lines=85 --test-coverage-branches=60 --test-coverage-functions=85 && node scripts/security-check.mjs && node scripts/protocol-smoke.mjs && node scripts/lifecycle-smoke.mjs",
    "dev": "node --watch src/server.mjs",
    "verify:cursor": "node scripts/verify-cursor-hooks.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.0",
    "onnxruntime-node": "1.30.0"
  }
}
